{
  "name": "cohort-harbor",
  "version": "0.1.0",
  "description": "Self-hosted employee onboarding, policy learning, and assessment platform.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailsazhang94-jpg/cohort-harbor.git"
  },
  "bugs": {
    "url": "https://github.com/ailsazhang94-jpg/cohort-harbor/issues"
  },
  "homepage": "https://github.com/ailsazhang94-jpg/cohort-harbor#readme",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/test-e2e.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "sbom:generate": "pnpm sbom --sbom-format spdx --lockfile-only --sbom-type application --out sbom.spdx.json",
    "db:ensure": "tsx scripts/ensure-database.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:onboarding": "tsx scripts/migrate-onboarding-features.ts",
    "portal:migrate": "tsx scripts/migrate-portal-scenes.ts",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "admin:init": "tsx scripts/init-admin.ts",
    "guides:import": "tsx scripts/import-guide-assets.ts",
    "data:reset": "tsx scripts/reset-local-data.ts",
    "mail:worker": "tsx scripts/run-onboarding-mail-worker.ts",
    "mail:install-launch-agent": "tsx scripts/install-onboarding-mail-launch-agent.ts",
    "exam:maintenance": "tsx scripts/run-exam-task-maintenance.ts",
    "exam:install-launch-agent": "tsx scripts/install-exam-task-maintenance-launch-agent.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tiptap/extension-image": "3.28.0",
    "@tiptap/react": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "archiver": "8.0.0",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "konva": "10.3.0",
    "lucide-react": "1.24.0",
    "next": "16.2.11",
    "nodemailer": "9.0.3",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-konva": "19.2.5",
    "sanitize-html": "2.17.6",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@types/yauzl": "3.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "postcss": "8.5.26",
    "prisma": "7.9.1",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
